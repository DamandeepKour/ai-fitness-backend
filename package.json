{
  "name": "ai-fitness-backend",
  "version": "1.0.0",
  "description": "A scalable Node.js backend that powers an AI-driven fitness platform, generating personalized diet and workout plans using LLM APIs.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node src/jobs/workerProcess.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/validation",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:load": "node tests/load/ai-plan.load.js",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamandeepKour/ai-fitness-backend.git"
  },
  "keywords": [],
  "author": "Damandeep Kour",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DamandeepKour/ai-fitness-backend/issues"
  },
  "homepage": "https://github.com/DamandeepKour/ai-fitness-backend#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "google-auth-library": "^10.9.0",
    "groq-sdk": "^1.1.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.0",
    "mysql2": "^3.22.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^8.0.11",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
