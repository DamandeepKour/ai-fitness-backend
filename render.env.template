NODE_ENV=production

# Railway → MySQL → Connect → copy MYSQL_PUBLIC_URL (not .railway.internal)
MYSQL_PUBLIC_URL=mysql://root:PASSWORD@shortline.proxy.rlwy.net:PORT/railway
DB_SSL=false

REDIS_URL=redis://red-xxxxxxxx:6379
JWT_SECRET=change-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
GROQ_API_KEY=your-groq-key
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=800
AI_LOG_METADATA=true

# Rate limiting (window in ms, max requests per window)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_PLAN_WINDOW_MS=900000
RATE_LIMIT_AI_PLAN_MAX=8
RATE_LIMIT_CONTACT_WINDOW_MS=3600000
RATE_LIMIT_CONTACT_MAX=10
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300

# Structured logging
LOG_LEVEL=info

# MongoDB — AI audit logs + analytics aggregations (optional; MySQL fallback used if unset)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fitnova
MONGODB_TIMEOUT_MS=10000

# Background jobs (BullMQ) — requires REDIS_URL
JOB_CONCURRENCY=5
JOB_WORKER_EMBEDDED=true
CRON_DAILY_REMINDERS=0 9 * * *
CRON_WEEKLY_SUMMARY=0 10 * * 1
CRON_STREAK_RECALC=15 0 * * *

# Cache TTLs (seconds) — plan outputs + analytics
PLAN_CACHE_TTL_SEC=3600
ANALYTICS_OVERVIEW_TTL_SEC=120
ANALYTICS_AI_USAGE_TTL_SEC=120
ANALYTICS_SUPERADMIN_TTL_SEC=60
ANALYTICS_AI_PLANS_TTL_SEC=60

# Health / readiness probe timeout (ms)
HEALTH_CHECK_TIMEOUT_MS=4000

# Frontend URL for app pages (login, reset password, etc.)
FRONTEND_URL=https://your-frontend.example.com

# Extra CORS origins (comma-separated), in addition to FRONTEND_URL
CORS_ORIGINS=

# Max JSON body size
BODY_SIZE_LIMIT=1mb

# Graceful shutdown timeout (ms)
SHUTDOWN_TIMEOUT_MS=15000

# Backend base URL for verification links (use your API URL in production)
APP_URL=https://your-api.example.com

# Email verification token expiry in minutes
VERIFICATION_EXPIRE_MINUTES=30

# Sender address (falls back to SMTP_FROM)
EMAIL_FROM=your-email@gmail.com

MAGIC_LINK_EXPIRES_HOURS=24

# SMTP (Gmail, SendGrid, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=FitNova AI

# Google Sign-In (FREE — create at https://console.cloud.google.com/)
# Same value as frontend VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
